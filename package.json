{
  "name": "dsh-blunt-dev",
  "version": "0.1.0",
  "description": "Inject a blunt senior-developer voice into every DeepSeek Harness agent session: no essay structure, no bold spam, no emoji, no closing elevation.",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.0-rc.1"
  },
  "scripts": {
    "test": "node test/index.test.mjs",
    "prepublishOnly": "node test/index.test.mjs"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "deepseek",
    "cordis",
    "prompt",
    "system-prompt",
    "persona",
    "tone",
    "writing-style",
    "chinese"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rosemary-ewe/dsh-blunt-dev.git"
  },
  "homepage": "https://github.com/rosemary-ewe/dsh-blunt-dev#readme",
  "bugs": {
    "url": "https://github.com/rosemary-ewe/dsh-blunt-dev/issues"
  }
}
